# Trusted Bash configuration sourced by start.sh. Protect with chmod 600.
# Incoming request order; only explicitly registered hooks are allowed.
LITELLM_HOOKS='activity'
# Preserve all environment variables required by your existing LiteLLM config.
LITELLM_MASTER_KEY='REPLACE_WITH_EXISTING_MASTER_KEY'
DATABASE_URL='postgresql://USER:PASSWORD@127.0.0.1:5432/litellm'
# asyncpg URI: no Prisma schema/connection_limit/pool_timeout query options.
LITELLM_ACTIVITY_DATABASE_URL='postgresql://USER:PASSWORD@127.0.0.1:5432/litellm'
# SHA256("customer/activity/v1:" + the API key configured in the desktop client).
LITELLM_ACTIVITY_TOKEN='REPLACE_WITH_64_CHARACTER_SHA256_HEX'
# Optional absolute paths; defaults are relative to start.sh.
# LITELLM_PYTHON='/opt/litellm/venv/bin/python'
# CONFIG_FILE_PATH='/etc/litellm/config.yaml'
LITELLM_HOST='127.0.0.1'
LITELLM_PORT='9108'
LITELLM_WORKERS='2'
