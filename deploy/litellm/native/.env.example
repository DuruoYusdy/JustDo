DATABASE_URL=postgresql://litellm:replace-with-url-encoded-password@127.0.0.1:5432/litellm
LITELLM_MASTER_KEY=replace-with-a-random-litellm-master-key
# Reuse the old salt (or old master key when no salt was configured) for an existing database.
LITELLM_SALT_KEY=replace-with-a-stable-database-encryption-secret
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-random-redis-password
MINIMUM_CUSTOM_KEY_LENGTH=16
LITELLM_JWT_ISSUER=https://login.example.com
LITELLM_JWT_AUDIENCE=model-service
LITELLM_JWT_JWKS_URL=https://login.example.com/.well-known/jwks.json
LITELLM_JWT_ALGORITHMS=RS256
LITELLM_JWT_MAX_LIFETIME_SECONDS=300
LITELLM_JWT_CLOCK_SKEW_SECONDS=30
LITELLM_DEFAULT_TEAM_ID=standard
LITELLM_HOOKS=activity
LITELLM_ACTIVITY_DATABASE_URL=postgresql://litellm:replace-with-url-encoded-password@127.0.0.1:5432/litellm
# Optional legacy activity digest and absolute UTC deadline; see ../README.md.
LITELLM_ACTIVITY_TOKEN=
LITELLM_ACTIVITY_LEGACY_EXPIRES_AT=
LITELLM_PORT=9108
LITELLM_WORKERS=4
